{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "closed-beta",
      "env": { "EXPO_PUBLIC_DEMO_MODE": "false" }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": { "EXPO_PUBLIC_DEMO_MODE": "false" }
    }
  },
  "submit": { "production": {} }
}
