{
  "expo": {
    "name": "MMEMME",
    "slug": "mmemme",
    "scheme": "mmemme",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ng.mmemme.app"
    },
    "android": {
      "package": "ng.mmemme.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFF9F3"
      }
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
